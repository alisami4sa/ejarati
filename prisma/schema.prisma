generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  buildings    Building[]
  tenants      Tenant[]
}

model Building {
  id              String   @id @default(cuid())
  ownerId         String
  name            String
  ownerRefNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  flats           Flat[]
}

model Flat {
  id                 String     @id @default(cuid())
  buildingId         String
  flatNumber         String
  floor              Int?
  rooms              Int?
  sizeSqm            Float?
  electricBoxNo      String?
  licenseNo          String?
  estimatedRent      Float      @default(0)
  estimatedServices  Float      @default(0)
  servicesPeriod     String     @default("monthly") // monthly | annual
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  building           Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contracts          Contract[]

  @@unique([buildingId, flatNumber])
}

model Tenant {
  id         String     @id @default(cuid())
  ownerId    String
  name       String
  nationalId String?
  mobile     String
  createdAt  DateTime   @default(now())
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contracts  Contract[]
}

model Contract {
  id                 String        @id @default(cuid())
  flatId             String
  tenantId           String
  contractNumber     String
  startDate          DateTime
  endDate            DateTime
  rentAmount         Float
  installmentCount   Int
  servicesIncluded   Boolean       @default(false)
  servicesAmount     Float         @default(0)
  servicesPeriod     String        @default("monthly") // monthly | annual
  status             String        @default("active") // active | inactive
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  flat               Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installments       Installment[]
}

model Installment {
  id         String    @id @default(cuid())
  contractId String
  dueDate    DateTime
  amount     Float
  status     String    @default("pending") // pending | paid | overdue
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([status])
}
